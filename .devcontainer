{
  "name": "Caso 1 - Inventario y riesgo de quiebre",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "ritwickdey.LiveServer"
      ]
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "echo 'Entorno listo. Ejecuta docker-compose up para ver la web.'"
}
